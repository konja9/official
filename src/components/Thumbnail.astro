---
import { thumbnailOf, type Work } from '../lib/works';

interface Props { work: Work; eager?: boolean }
const { work, eager = false } = Astro.props;
const src = thumbnailOf(work);
---
<div class="thumb">
  {src ? (
    <img src={src} alt={`${work.data.title} のサムネイル`} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class={`placeholder p-${work.data.platform}`} role="img" aria-label={work.data.title}>
      <span>{work.data.title}</span>
    </div>
  )}
</div>

<style>
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; background: var(--border); }
  img { width: 100%; height: 100%; object-fit: cover; }
  .placeholder {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    padding: 16px;
    text-align: center;
    font-weight: 800;
    font-size: clamp(1.1rem, 4vw, 1.6rem);
    color: var(--muted);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--haniwa) 8%, transparent) 14px 28px),
      var(--surface);
  }
</style>
