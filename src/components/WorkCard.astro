---
import Tag from './Tag.astro';
import Thumbnail from './Thumbnail.astro';
import { withBase, type Work } from '../lib/works';

interface Props { work: Work; eager?: boolean }
const { work, eager } = Astro.props;
const { title, platform, status, summary, date, featured } = work.data;
---
<article class:list={['card', { featured }]} data-status={status}>
  <a href={withBase(`/works/${work.id}/`)}>
    <Thumbnail work={work} eager={eager} />
    <div class="body">
      <div class="tags">
        <Tag kind="platform" value={platform} />
        <Tag kind="status" value={status} />
        {platform === 'psp' && <Tag kind="text" value="PSP実機で動作" />}
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
      <time>{date}</time>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card[hidden] { display: none; }
  a { display: block; color: inherit; text-decoration: none; height: 100%; }
  a:hover h2 { color: var(--accent); }
  .body { padding: 12px 16px 16px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  h2 { font-size: 1.15rem; margin: 8px 0 2px; }
  p { margin: 0; color: var(--muted); font-size: .92rem; }
  time { display: block; margin-top: 6px; font-size: .8rem; color: var(--muted); }
  @media (min-width: 640px) {
    .featured { grid-column: span 2; }
    .featured h2 { font-size: 1.4rem; }
  }
</style>
