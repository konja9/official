---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import Thumbnail from '../../components/Thumbnail.astro';
import PlayButton from '../../components/PlayButton.astro';
import Media from '../../components/Media.astro';
import { getWorks, withBase, type Work } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props { work: Work }
const { work } = Astro.props;
const { title, platform, status, date, summary, tech, links } = work.data;
const { Content } = await render(work);

// browser 以外は動画/GIFがあればそれを主役に、無ければサムネイル
const heroIsMedia = platform !== 'browser' && !!links.video;
---
<Base title={title} description={summary}>
  <article>
    <div class="hero">
      {heroIsMedia ? <Media src={links.video!} title={title} /> : <Thumbnail work={work} eager />}
    </div>

    <div class="tags">
      <Tag kind="platform" value={platform} />
      <Tag kind="status" value={status} />
      {platform === 'psp' && <Tag kind="text" value="PSP実機で動作" />}
    </div>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>

    <div class="actions">
      {platform === 'browser' && links.play && <PlayButton href={links.play} />}
      {platform === 'android' && links.store && <PlayButton href={links.store} label="ストアで見る" />}
      {links.repo && <a class="button" href={withBase(links.repo)} target="_blank" rel="noopener">ソースコード</a>}
    </div>

    {!heroIsMedia && links.video && <div class="sub-media"><Media src={links.video} title={title} /></div>}

    <dl class="meta">
      <dt>年月</dt><dd>{date}</dd>
      {tech.length > 0 && <><dt>技術</dt><dd>{tech.join(' / ')}</dd></>}
    </dl>

    <div class="content"><Content /></div>

    <p><a href={withBase('/')}>← 作品一覧へ</a></p>
  </article>
</Base>

<style>
  article { max-width: 760px; margin: 0 auto; }
  .hero { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
  .hero :global(.media) { border: 0; border-radius: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  h1 { margin: 8px 0 4px; font-size: 1.8rem; line-height: 1.3; }
  .summary { margin: 0; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0; }
  .sub-media { margin-bottom: 24px; }
  .meta { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; font-size: .9rem; }
  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; }
  .content :global(h2) { font-size: 1.15rem; margin-top: 28px; border-left: 4px solid var(--haniwa); padding-left: 10px; }
</style>
